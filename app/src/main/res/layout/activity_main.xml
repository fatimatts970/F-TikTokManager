<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="F TikTok Manager"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVcamToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎭 VCAM: OFF"
            android:backgroundTint="@color/bg_card"
            android:textColor="@color/gold"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/gold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/listViewClones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp" />

    <Button
        android:id="@+id/btnAddClone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="+ Add New Clone Account"
        android:backgroundTint="@color/gold"
        android:textColor="@color/bg_main"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />
</LinearLayout>
